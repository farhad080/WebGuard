{
  "name": "webguard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build:packages",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pretypecheck": "npm run build:packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "worker": "npm run worker --workspace apps/api",
    "build:packages": "npm run build --workspace @webguard/core && npm run build --workspace @webguard/analysis",
    "dev:web": "npm run dev --workspace apps/web",
    "seed:demo": "npm run seed:demo --workspace apps/api --",
    "demo": "node scripts/demo.mjs",
    "e2e": "npm run e2e --workspace apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
