generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  projects     Project[]

  @@map("users")
}

model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans     Scan[]

  @@index([userId])
  @@map("projects")
}

enum ScanStatus {
  queued
  running
  completed
  failed

  @@map("scan_status")
}

model Scan {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  status      ScanStatus @default(queued)
  startedAt   DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?  @map("finished_at") @db.Timestamptz(6)
  summaryJson Json?      @map("summary_json")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings    Finding[]
  artifacts   Artifact[]

  @@index([projectId])
  @@map("scans")
}

/// Must stay in sync with `Severity` in packages/core.
enum Severity {
  critical
  high
  medium
  low
  info

  @@map("severity")
}

model Finding {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scanId                String   @map("scan_id") @db.Uuid
  detectorId            String   @map("detector_id")
  owaspCategory         String   @map("owasp_category")
  severity              Severity
  /// 0–1, enforced by a CHECK constraint in the migration.
  confidence            Float    @db.Real
  filePath              String   @map("file_path")
  lineStart             Int      @map("line_start")
  lineEnd               Int      @map("line_end")
  snippet               String
  explanation           String
  fixSuggestion         String   @map("fix_suggestion")
  /// All detectors that reported this issue (correlated findings have more than one).
  contributingDetectors String[] @default([]) @map("contributing_detectors")
  /// Short reasons from each contributing detector.
  evidence              String[] @default([])
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  scan                  Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  // Leading scan_id column also serves as the foreign-key index.
  @@index([scanId, severity])
  @@map("findings")
}

enum ArtifactKind {
  raw_zip
  extracted
  report

  @@map("artifact_kind")
}

model Artifact {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scanId     String       @map("scan_id") @db.Uuid
  kind       ArtifactKind
  storageKey String       @map("storage_key")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  scan       Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("artifacts")
}
