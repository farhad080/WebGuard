# API
PORT=3000
NODE_ENV=development
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Postgres
POSTGRES_USER=webguard
POSTGRES_PASSWORD=webguard
POSTGRES_DB=webguard
POSTGRES_PORT=5432
DATABASE_URL=postgres://webguard:webguard@localhost:5432/webguard
# Separate database used by the test suite (reset on every run; name must end in _test)
TEST_DATABASE_URL=postgres://webguard:webguard@localhost:5432/webguard_test

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Storage & uploads
# Local-filesystem StorageService root (relative paths resolve from apps/api)
STORAGE_DIR=./storage
# Max ZIP upload size in bytes (default 50 MB)
MAX_UPLOAD_BYTES=52428800

# Safe extraction limits (zip-bomb protection)
EXTRACT_MAX_TOTAL_BYTES=524288000
EXTRACT_MAX_FILES=20000
EXTRACT_MAX_COMPRESSION_RATIO=100

# BullMQ queue name
SCAN_QUEUE_NAME=scans

# Analysis
# Source files larger than this are profiled but not parsed (default 1 MB)
ANALYSIS_MAX_FILE_BYTES=1048576

# Remediation: optional LLM assist for secure-code snippets (off by default).
# Only used when REMEDIATION_LLM=true AND ANTHROPIC_API_KEY is set; otherwise no code leaves the server.
REMEDIATION_LLM=false
ANTHROPIC_API_KEY=
# REMEDIATION_LLM_MODEL=claude-opus-5-5

# Reports: PDF export uses the preinstalled Chromium/Chrome (never downloaded at runtime).
# Leave empty to auto-detect common install paths.
CHROMIUM_PATH=
# How long GET /api/scans/:id/report.pdf waits for the worker before answering 202 (ms)
REPORT_PDF_WAIT_MS=60000
# Pre-render the PDF in the worker when a scan completes
REPORT_PDF_ON_COMPLETE=true
