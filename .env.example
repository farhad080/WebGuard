# API
PORT=3000
NODE_ENV=development
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Postgres
POSTGRES_USER=webguard
POSTGRES_PASSWORD=webguard
POSTGRES_DB=webguard
POSTGRES_PORT=5432
DATABASE_URL=postgres://webguard:webguard@localhost:5432/webguard
# Separate database used by the test suite (reset on every run; name must end in _test)
TEST_DATABASE_URL=postgres://webguard:webguard@localhost:5432/webguard_test

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Storage & uploads
# Local-filesystem StorageService root (relative paths resolve from apps/api)
STORAGE_DIR=./storage
# Max ZIP upload size in MB (multer streams the file to disk; over it → 413 stating the limit).
# The SPA reads it from GET /api/limits. Raise any reverse proxy's body limit to match
# (nginx: client_max_body_size).
MAX_UPLOAD_MB=512
# How long one upload request may take to arrive (ms); slow large uploads need minutes.
UPLOAD_TIMEOUT_MS=600000

# Safe extraction limits (zip-bomb protection; a scan that hits one fails with the reason)
# Total uncompressed size of the archive (MB)
MAX_EXTRACTED_MB=2048
# Max entries (files + directories) in the archive
MAX_EXTRACTED_FILES=60000
# Max uncompressed:compressed ratio of one entry (entries >= 1 MB)
MAX_COMPRESSION_RATIO=200
# Older byte-based names (MAX_UPLOAD_BYTES, EXTRACT_MAX_TOTAL_BYTES, EXTRACT_MAX_FILES,
# EXTRACT_MAX_COMPRESSION_RATIO) are still honored when the new ones are unset.

# BullMQ queue name
SCAN_QUEUE_NAME=scans

# Analysis
# Source files larger than this are profiled but not parsed (default 1 MB)
ANALYSIS_MAX_FILE_BYTES=1048576

# Remediation: optional LLM assist for secure-code snippets (off by default).
# Only used when REMEDIATION_LLM=true AND ANTHROPIC_API_KEY is set; otherwise no code leaves the server.
REMEDIATION_LLM=false
ANTHROPIC_API_KEY=
# REMEDIATION_LLM_MODEL=claude-opus-5-5

# Reports: PDF export uses the preinstalled Chromium/Chrome (never downloaded at runtime).
# Leave empty to auto-detect common install paths.
CHROMIUM_PATH=
# How long GET /api/scans/:id/report.pdf waits for the worker before answering 202 (ms)
REPORT_PDF_WAIT_MS=60000
# Pre-render the PDF in the worker when a scan completes
REPORT_PDF_ON_COMPLETE=true

# Web app (apps/web)
# Public URL of the SPA; the API puts it in password-reset links.
APP_BASE_URL=http://localhost:5173
# Base URL the browser uses to call the API. Leave empty for same origin: the Vite dev server
# proxies /api to the API (so no CORS is needed). Set it only when serving the SPA elsewhere.
VITE_API_BASE_URL=
# Where the Vite dev/preview proxy forwards /api (default: http://localhost:$PORT).
# VITE_API_PROXY_TARGET=http://localhost:3000
# E2E smoke (npm run e2e --workspace apps/web) runs its own API on this port.
# E2E_API_PORT=3100

# Scan limits (the analysis runs in an isolated worker thread)
# Wall-clock limit per scan job, extraction through detection (ms)
SCAN_TIMEOUT_MS=600000
# Heap cap for a scan's analysis thread (MB)
SCAN_MAX_HEAP_MB=1024

# Network policy: scans never need the network. OFFLINE=true forbids every outbound call,
# overriding the opt-in features (OSV_ADVISORIES, REMEDIATION_LLM).
OFFLINE=false
# Opt-in: also query OSV.dev for dependency advisories (default: bundled offline snapshot only)
OSV_ADVISORIES=false

# HTTP hardening
# Origins allowed to call the API cross-origin (comma-separated; default APP_BASE_URL)
# CORS_ORIGIN=http://localhost:5173
# Set when behind a reverse proxy so rate limits see client IPs (e.g. 1, or loopback)
# TRUST_PROXY=1
# Credential attempts (POST /api/auth/*) per client IP per 15 minutes
AUTH_RATE_LIMIT=30
# ZIP uploads per user per hour
UPLOAD_RATE_LIMIT=30

# Demo seed (npm run seed:demo / npm run demo) — local development only
# DEMO_EMAIL=demo@webguard.local
# DEMO_PASSWORD=webguard-demo
